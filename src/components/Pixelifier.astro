---
import { Image } from 'astro:assets';

interface Props {
  imgPath: string;
}

const { imgPath } = Astro.props;
---

<img src="icons/linkedin.png" alt="" />
<div class="images">
  <!-- <img src=`${imgPath}` alt="" /> -->
  <!-- <img src="icons/linkedin.png" alt="" /> -->
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let c = document.createElement('canvas');
    let img = new Image();

    img.onload = () => {
      document.querySelector('.img')?.remove();
      let w = img.width;
      let h = img.height;

      c.width = w;
      c.height = h;
      let ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0);

      let pixelArr = ctx.getImageData(0, 0, w, h).data;
      let sampleSize = 40;

      for (let y = 0; y < h; y += sampleSize) {
        for (let x = 0; x < w; x += sampleSize) {
          let p = (x + y * w) * 4;
          ctx.fillStyle =
            'rgba(' +
            pixelArr[p] +
            ',' +
            pixelArr[p + 1] +
            ',' +
            pixelArr[p + 2] +
            ',' +
            pixelArr[p + 3] +
            ')';
          ctx.fillRect(x, y, sampleSize, sampleSize);
        }
      }

      let imgPixelated = new Image();
      imgPixelated.src = c.toDataURL();
      imgPixelated.width = 40;

      let divElement = document.querySelector('.images');
      divElement.appendChild(imgPixelated);
    };

    img.src = document.querySelector('.img').src;
  });
</script>
