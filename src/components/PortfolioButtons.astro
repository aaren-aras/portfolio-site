---
import { Image } from 'astro:assets';
import LinkedIn from '../assets/linkedin.png';
import GitHub from '../assets/github.png';
import YouTube from '../assets/youtube.png';
import Document from '../assets/document.png';
---

<div>
  <a href="https://www.linkedin.com/in/aaren-aras/" target="_blank">
    <!-- <Image src={LinkedIn} alt="LinkedIn" /> -->
    <img class="portfolio-btn" src="icons/linkedin.png" alt="LinkedIn" />
  </a>
  <a href="https://github.com/aaren-aras" target="_blank">
    <img class="portfolio-btn" src="icons/github.png" alt="GitHub" />
  </a>
  <a href="">
    <img src="../assets/youtube.png" alt="YouTube" />
  </a>
  <a href="">
    <img src="icons/document.png" alt="Resume + Portfolio" />
  </a>
</div>

<script type="">
  import { pixelifyImage } from '../scripts/pixelifier.ts';

  const portfolioBtns = document.querySelectorAll('.portfolio-btn');

  for (const btn of portfolioBtns) {
    const btnElement = btn as HTMLImageElement;
    const imgPath = btnElement.src;
    console.log(imgPath);
    try {
      const imgPath = btnElement.src;
      console.log(imgPath);
      const pixelatedSrc = await pixelifyImage(imgPath, 20);
      btnElement.src = pixelatedSrc;
    } catch (e) {
      console.error('Error with pixelifying image:', e);
    }
  }
</script>

<style lang="scss">
  @import '../global.scss';

  div {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    z-index: 100;
    position: fixed;
    top: 8em;
    right: 2.5rem;

    img {
      width: 30px;
      height: 30px;
      object-fit: cover;
      // filter: blur(2px);
      image-rendering: crisp-edges;
      &:hover {
        filter: opacity(50%);
        @include transition-ease;
      }
    }
  }
</style>
