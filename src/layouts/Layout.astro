---
import NavBar from '../components/NavBar.astro';
import ForceDirectedGraph from '../components/ForceDirectedGraph.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import EffectButtons from '../components/EffectButtons.astro';
import PortfolioButtons from '../components/PortfolioButtons.astro';
import LoadingScreen from '../components/LoadingScreen.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!-- TO DO: add all main layout UI buttons on the corners --><!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio website!" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<LoadingScreen />
		<!-- <div class="bkgd"></div>
		<div class="bkgd-1"></div> -->
		<div class="bkgd"></div>
		<PortfolioButtons />

		<!-- <EffectButtons/> -->
		<ForceDirectedGraph />
		<slot />
		<!-- <NavBar /> -->
		<AudioPlayer />
	</body>
</html>

<style lang="scss">
	@import '../global.scss';

	body {
		// background: $primary;
		.bkgd {
			width: 50%;
			min-height: 231%;
			background: url('me.jpg') repeat-y;
			background-size: contain;
			filter: contrast(0%) opacity(35%) blur(0px)
				drop-shadow(20em 1px 5px $accent-3);
			z-index: -500;
			position: absolute;
			top: 0em;

			// Consider (repeating-)linear-gradient or (repeating-)radial-gradient?
			// background: repeating-conic-gradient($primary 70%, $secondary 30%);
			// background-size: 100% 100%;
			// opacity: 0.1;
			// z-index: -1;
			// position: fixed;
			// inset: 0;
			// animation: gradient 50s linear infinite;
			// perspective: 5000px;
			// transform-style: preserve-3d;
			// &::after {
			// 	content: '';
			// 	background: url('linkedin-me.png');
			// 	filter: contrast(50%) opacity(100%) blur(4px) drop-shadow(30em 1px 5px $accent-3);
			// 	z-index: -1;
			// 	position: fixed;
			// 	right: 2rem;
			// 	animation: test 50s linear infinite;

			// }
		}

		@keyframes gradient {
			0% {
				background-position: 0% 0%;
				transform: translateY(75%);
			}
			100% {
				background-position: 100% 100%;
				transform: translateX(25%);
			}
		}

		.bkgd-1 {
			width: 100px;
			height: 300px;
			// Consider (repeating-)linear-gradient or (repeating-)radial-gradient?
			// background: repeating-conic-gradient($primary 70%, $secondary 30%);
			background: black;
			// background-size: 100% 100%;
			opacity: 0.1;
			z-index: -1;
			position: fixed;
			inset: 4em;
			perspective: 1000px;
			transform-style: preserve-3d;
			transform: skew(0deg, 30deg);
			transform: rotateZ(30deg);
			animation: gradient 10s linear infinite;
		}
	}
</style>
