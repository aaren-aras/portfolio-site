---
interface Props {
  imgPath: string;
}

const { imgPath } = Astro.props;
---

<div>
  <img src=`${imgPath}` alt="" />
</div>

<script>
  let c = document.createElement('canvas');
  let img = new Image();

  img.onload = () => {};

  img.src = document.querySelector('img').src;

  // img1.src =
</script>
